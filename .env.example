# Copie este arquivo para ".env" (na raiz do projeto, ao lado do pom.xml) e preencha com os seus valores.
# O ".env" é ignorado pelo Git. Este ".env.example" pode ir para o GitHub, pois não tem segredos.

# Senha do usuário do PostgreSQL
DB_PASSWORD=troque-esta-senha

# Chave da API do Resend (painel do Resend > API Keys). Começa com "re_"
RESEND_API_KEY=re_troque_esta_chave

# Segredo que assina os tokens de login. Use um texto longo e aleatório (mínimo 32 caracteres).
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio-com-mais-de-32-caracteres

# Opcionais (têm valor padrão para desenvolvimento local):
# DB_URL=jdbc:postgresql://localhost:5432/organizador_contas
# DB_USER=postgres
# SHOW_SQL=false
# JWT_EXPIRACAO_HORAS=10
# FRONTEND_URL=http://localhost:4200
# BACKEND_URL=http://localhost:8080